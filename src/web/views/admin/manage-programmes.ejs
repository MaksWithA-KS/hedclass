<!--Inject the global header partial-->
<%- include('../partials/header') %>

    <!--Breadcrumb-->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb py-2 px-3 bg-light rounded shadow-sm border">
            <li class="breadcrumb-item">
                <a href="/admin-dashboard" class="text-decoration-none text-navy fw-bold">
                    Admin Hub
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <%= (typeof pageTitle !=='undefined' ) ? pageTitle : 'Management' %>
            </li>
        </ol>
    </nav>

    <!--Page header-->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Academic Programmes</h2>
        <!--Triggers the create programme modal-->
        <button class="btn btn-main" data-bs-toggle="modal" data-bs-target="#addProgModal">
            + Add New Programme
        </button>
    </div>

    <!--Data table-->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>L5 / L6 Weights</th>
                        <th>Assigned Officers</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% programmes.forEach(p=> { %>
                        <tr>
                            <td>#<%= p.programme_id %>
                            </td>
                            <td class="fw-bold">
                                <%= p.title %>
                            </td>
                            <td>
                                <!--Convert decimals in database to percentages-->
                                <%= (p.y2_weighting * 100) %>% / <%= (p.y3_weighting * 100) %>%
                            </td>
                            <td>
                                <!--Displays assigned officers or a fallback 'Empty State' message-->
                                <% if (p.assigned_officers) { %>
                                    <span class="badge bg-light text-dark border shadow-sm px-2 py-1">
                                        <%= p.assigned_officers %>
                                    </span>
                                <% } else { %>
                                    <span class="text-muted fst-italic" style="font-size: 0.9em;">
                                        No staff assigned
                                    </span>
                                <% } %>
                            </td>
                            <!--Triggers the edit modal-->
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary me-2"
                                    onclick="openEditModal('<%= p.programme_id %>', '<%= p.title %>', <%= p.y2_weighting %>, <%= p.y3_weighting %>)">
                                    Edit
                                </button>
                                <!--POST form for deletion-->
                                <form action="/admin/programmes/delete/<%= p.programme_id %>" method="POST"
                                    class="d-inline"
                                    onsubmit="return confirm('Warning: Deleting this programme will permanently remove all associated officer assignments. Continue?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!--Contextual Back Navigation-->
    <div class="d-flex justify-content-start mt-4 mb-4">
        <a href="/admin-dashboard" class="btn btn-outline-secondary fw-bold shadow-sm">
            &larr; Back to Administrator Dashboard
        </a>
    </div>

    <!--Create programme modal-->
    <div class="modal fade" id="addProgModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/admin/programmes/add" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Create Programme</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Programme Title</label>
                            <input type="text" name="title" class="form-control" required>
                        </div>
                        <div class="row">
                            <!--Pre-filled default weightings as per standard university regulations-->
                            <div class="col-6">
                                <label class="form-label">L5 Weight</label>
                                <input type="number" name="y2" step="0.01" class="form-control" value="0.30">
                            </div>
                            <div class="col-6">
                                <label class="form-label">L6 Weight</label>
                                <input type="number" name="y3" step="0.01" class="form-control" value="0.70">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-main">Save Programme</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!--Edit programme modal-->
    <div class="modal fade" id="editProgModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editProgForm" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Programme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Programme Title</label>
                        <input type="text" name="title" id="edit_title" class="form-control" required>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">L5 Weight</label>
                            <input type="number" name="y2" id="edit_y2" step="0.01" class="form-control" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label">L6 Weight</label>
                            <input type="number" name="y3" id="edit_y3" step="0.01" class="form-control" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-main">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--Client-side script to handle form population-->
<script>
function openEditModal(id, title, y2, y3) {
    // Update the form's submission URL to target the correct programme ID
    document.getElementById('editProgForm').action = '/admin/programmes/edit/' + id;
    
    // Populate input fields with existing data
    document.getElementById('edit_title').value = title;
    document.getElementById('edit_y2').value = y2;
    document.getElementById('edit_y3').value = y3;
    
    // Trigger the modal display
    const editModal = new bootstrap.Modal(document.getElementById('editProgModal'));
    editModal.show();
}
</script>

<!--Inject global footer partial-->
<%- include('../partials/footer') %>