<!--Inject the global header partial-->
<%- include('../partials/header') %>

<!--Breadcrumb-->    
<nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb py-2 px-3 bg-light rounded shadow-sm border">
            <li class="breadcrumb-item"><a href="/officer-dashboard">Officer Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">
                <%= programme.title %>
            </li>
        </ol>
    </nav>

    <!--Classification Bar Chart-->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="card-title fw-bold text-secondary mb-3">Cohort Distribution</h5>
            <div style="height: 300px; width: 100%; display: flex; justify-content: center;">
                <canvas id="classificationChart"></canvas>
            </div>
        </div>
    </div>

    <!--Programme Header-->
    <div class="dashboard-header mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2>
                <%= programme.title %>
            </h2>
            <p class="text-muted mb-0">Programme ID: <%= programme.programme_id %> | Level 5 Weight: <%=
                        (programme.y2_weighting * 100) %>% | Level 6 Weight: <%= (programme.y3_weighting * 100) %>%</p>
        </div>

        <div>
            <!--Execute classification engine trigger-->
            <form action="/officer/programme/<%= programme.programme_id %>/calculate" method="POST" class="d-inline">
                <button type="submit" class="btn btn-warning shadow-sm me-2 fw-bold text-dark">
                    Execute Classification Rules
                </button>
            </form>

            <!--Add student button-->
            <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addStudentModal">
                + Add Student
            </button>

            <!--CSV export button-->
            <a href="/officer/programme/<%= programme.programme_id %>/export"
                class="btn btn-outline-secondary shadow-sm">
                Export Board CSV
            </a>
        </div>
    </div>


    <!--Data table-->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Student ID</th>
                            <th>Name</th>
                            <th class="text-center">L5 Average</th>
                            <th class="text-center">L6 Average</th>
                            <th>Final Classification</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (students.length===0) { %>
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No students currently enrolled in
                                    this programme.</td>
                            </tr>
                            <% } else { %>
                                <% students.forEach(student=> { %>
                                    <tr>
                                        <td class="ps-4 fw-bold">
                                            <%= student.student_id %>
                                        </td>
                                        <td>
                                            <%= student.first_name %>
                                                <%= student.last_name %>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">
                                                <%= student.level_5_average !==null ? student.level_5_average + '%'
                                                    : 'N/A' %>
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">
                                                <%= student.level_6_average !==null ? student.level_6_average + '%'
                                                    : 'N/A' %>
                                            </span>
                                        </td>
                                        <td>
                                            <!--Badges based on Award-->
                                            <% if (student.final_classification==='Pending' ) { %>
                                                <span class="badge bg-warning text-dark">
                                                    <%= student.final_classification %>
                                                </span>
                                                <% } else if (student.final_classification==='Fail' ) { %>
                                                    <span class="badge bg-danger">
                                                        <%= student.final_classification %>
                                                    </span>
                                                    <% } else { %>
                                                        <span class="badge bg-success">
                                                            <%= student.final_classification %>
                                                        </span>
                                                        <% } %>

                                                        <!--Highlights Overrides-->    
                                                        <% if (student.manual_override) { %>
                                                            <span class="badge bg-info text-dark ms-1"
                                                                title="Manually Overriden">Override</span>
                                                        <% } %>
                                        </td>
                                        <td class="text-end pe-4">
                                            <!--Link to the detailed student profile-->
                                            <a href="/officer/student/<%= student.student_id %>"
                                                class="btn btn-sm btn-outline-primary">
                                                Manage Profile
                                            </a>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!--Add student modal-->
    <div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <form action="/officer/programme/<%= programme.programme_id %>/student/add" method="POST">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title" id="addStudentModalLabel">Add Candidate</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label for="student_id" class="form-label fw-bold">Student ID</label>
                            <input type="number" class="form-control" id="student_id" name="student_id" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="first_name" class="form-label fw-bold">First Name</label>
                                <input type="text" class="form-control" id="first_name" name="first_name" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="last_name" class="form-label fw-bold">Last Name</label>
                                <input type="text" class="form-control" id="last_name" name="last_name" required>
                            </div>
                        </div>
                        <p class="text-muted small mt-2">
                            The candidate will be added to the <strong>
                                <%= programme.title %>
                            </strong> classification cohort with a default status of 'Pending'. Module marks must be
                            inputted via their individual profile.
                        </p>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-main">Save Candidate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!--Contextual back navigation-->
    <div class="d-flex justify-content-start mt-4 mb-2">
        <a href="/officer-dashboard" class="btn btn-outline-secondary fw-bold shadow-sm">
            &larr; Back to My Programmes
        </a>
    </div>

    <!--Client-side chart for classification distribution-->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Inject EJS payload into client-side JS
            const students = <%- JSON.stringify(students) %>;

            // Initialise the tally dictionary based on institutional award boundaries
            const tally = {
            'First Class Honours (1st)': 0,
            'Upper Second Class (2:1)': 0,
            'Lower Second Class (2:2)': 0,
            'Third Class Honours (3rd)': 0,
            'Not eligible for Honours Classification': 0,
            'Fail': 0,
            'Pending': 0
            };

            // Populate tally
            students.forEach(student => {
                const classification = student.final_classification || 'Pending';
                if (tally[classification] !== undefined) {
                    tally[classification]++;
                } else {
                    tally['Pending']++;
                }
            });

            // Render chart
            const ctx = document.getElementById('classificationChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: Object.keys(tally),
                    datasets: [{
                        label: 'Number of Students',
                        data: Object.values(tally),
                        backgroundColor: [
                            '#198754', // First (Green)
                            '#0d6efd', // 2:1 (Blue)
                            '#0dcaf0', // 2:2 (Cyan)
                            '#ffc107', // 3rd (Yellow)
                            '#fd7e14', // Not Eligible (Orange)
                            '#dc3545', // Fail (Red)
                            '#6c757d'  // Pending (Grey)
                        ],
                        borderWidth: 1
                    }]
                },
               options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    // Styling adapts axes colours to current light or dark mode state
                    scales: {
                        x: {
                            ticks: {
                                // Use a light grey for axis text
                                color: document.body.classList.contains('dark-mode') ? '#e0e0e0' : '#666'
                            },
                            grid: {
                                color: document.body.classList.contains('dark-mode') ? '#444' : '#e5e5e5'
                            }
                        },
                        y: {
                            ticks: {
                                color: document.body.classList.contains('dark-mode') ? '#e0e0e0' : '#666'
                            },
                            grid: {
                                color: document.body.classList.contains('dark-mode') ? '#444' : '#e5e5e5'
                            }
                        }
                    }
                }
            });
        });
    </script>

<!--Inject global footer partial-->
<%- include('../partials/footer') %>