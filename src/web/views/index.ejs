<%- include('partials/header') %>

    <section class="container px-4 py-5 my-5 text-center">
        <h1 class="display-5 fw-bold mb-3">HEdClass Management System</h1>
        <div class="col-lg-6 mx-auto">

            <p class="lead mb-4 text-muted">
                A centralised portal for managing university programmes, student module registrations, and final grade
                classification.
            </p>

            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                <% if (session && session.userRole) { %>
                    <a href="/dashboard" class="btn btn-main btn-lg px-5 shadow-sm">Go To Dashboard</a>    
                <% } else {%>
                    <a href="/login" class="btn btn-main btn-lg px-5 shadow-sm">System Login</a>    
                <% } %>
            </div>

        </div>
    </section>

    <section id="about" class="container px-4 py-5">
        <div id="about-section" class="container py-5 mt-5 border-top">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <h2 class="fw-bold mb-3">Streamlining Academic Classifications</h2>
                    <p class="lead text-muted">HEdClass replaces vulnerable spreadsheet-based grading with a
                        deterministic, secure, and fully auditable web platform.</p>
                    <ul class="list-unstyled mt-4 d-inline-block text-start">
                        <li class="mb-2">✓ <strong>Automated Rules:</strong> Instantly calculates programme weightings.</li>
                        <li class="mb-2">✓ <strong>Role-Based Security:</strong> Strict access control for Officers and Admins.</li>
                        <li class="mb-2">✓ <strong>Audit Ready:</strong> Full support for manual board overrides.</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

<%- include('partials/footer') %>