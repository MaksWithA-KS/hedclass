# Copy this file to .env and fill in your local MySQL details.
# .env is git-ignored and should never be committed.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hedclass

# Secret used to sign session cookies. Use any long random string locally.
SESSION_SECRET=change-me-to-a-long-random-string

WEB_PORT=3000
API_PORT=4000
